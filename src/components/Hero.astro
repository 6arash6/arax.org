---
---

<section class="min-h-screen flex items-center justify-center relative overflow-hidden pt-16">
  <!-- Background gradient -->
  <div class="absolute inset-0 bg-gradient-to-b from-indigo-950/20 via-transparent to-transparent"></div>
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-indigo-500/10 rounded-full blur-[120px]"></div>

  <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
    <div class="animate-fade-in-up">
      <img src="/img/arax_labs_logo_square_gradient_clean.png" alt="ARAX LABS" class="w-24 h-24 mx-auto mb-8" />
    </div>

    <h1 class="text-5xl md:text-7xl font-bold mb-6 animate-fade-in-up delay-100">
      <span class="gradient-text">ARAX LABS</span>
    </h1>

    <p class="text-xl md:text-2xl text-slate-300 mb-8 animate-fade-in-up delay-200">
      AI-Driven Predictive Scaling<br />
      for Energy-Efficient Infrastructure
    </p>

    <div class="flex flex-wrap justify-center gap-4 mb-12 animate-fade-in-up delay-300">
      <span class="px-4 py-2 rounded-full text-sm border border-indigo-500/30 bg-indigo-500/10 text-indigo-300">
        INiTS ScaleUp
      </span>
      <span class="px-4 py-2 rounded-full text-sm border border-indigo-500/30 bg-indigo-500/10 text-indigo-300">
        AWS First Incubator
      </span>
      <span class="px-4 py-2 rounded-full text-sm border border-indigo-500/30 bg-indigo-500/10 text-indigo-300">
        TRL 6
      </span>
    </div>

    <div class="flex flex-wrap justify-center gap-4 animate-fade-in-up delay-400">
      <a href="#solution" class="px-8 py-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg font-medium transition-colors">
        See Our Solution
      </a>
      <a href="#contact" class="px-8 py-3 border border-slate-600 hover:border-slate-400 text-slate-300 rounded-lg font-medium transition-colors">
        Get in Touch
      </a>
    </div>
  </div>
</section>
