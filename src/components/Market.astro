---
---

<section id="market" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold mb-4">
      <span class="gradient-text">Market Opportunity</span>
    </h2>
    <p class="text-slate-400 text-lg mb-12 max-w-2xl">
      Two revenue streams: direct data center savings + energy utility SaaS.
    </p>

    <!-- Market segments -->
    <div class="grid md:grid-cols-2 gap-8 mb-12">
      <div class="gradient-border rounded-2xl p-8 text-center">
        <h3 class="text-white text-xl font-semibold mb-4">Data Centers</h3>
        <div class="text-4xl font-bold gradient-text mb-2">€500K–€5M</div>
        <p class="text-slate-400 mb-4">annual energy costs per mid-size facility</p>
        <div class="text-green-400 font-medium">15–30% savings → €75K–€1.5M/customer</div>
      </div>
      <div class="gradient-border rounded-2xl p-8 text-center">
        <h3 class="text-white text-xl font-semibold mb-4">Energy Utilities</h3>
        <div class="text-4xl font-bold gradient-text mb-2">B2B2B SaaS</div>
        <p class="text-slate-400 mb-4">Predictive load forecasting for grid management</p>
        <div class="text-green-400 font-medium">Larger contract values, recurring revenue</div>
      </div>
    </div>

    <!-- ARR projection -->
    <div class="grid md:grid-cols-2 gap-8 mb-12">
      <div class="gradient-border rounded-2xl p-8 text-center">
        <div class="text-4xl font-bold text-green-400 mb-2">€37.5K–€3M</div>
        <p class="text-slate-400">ARR potential by Year 2 (5–10 customers)</p>
      </div>
      <div class="gradient-border rounded-2xl p-8 text-center">
        <div class="text-4xl font-bold text-green-400 mb-2">10–20%</div>
        <p class="text-slate-400">of customer savings = ARAX revenue</p>
      </div>
    </div>

    <!-- Market drivers -->
    <div class="flex flex-wrap gap-3 justify-center">
      <span class="px-4 py-2 rounded-lg text-sm border border-indigo-500/30 bg-indigo-500/10 text-indigo-300">EU Green Deal</span>
      <span class="px-4 py-2 rounded-lg text-sm border border-indigo-500/30 bg-indigo-500/10 text-indigo-300">Energy Efficiency Directive</span>
      <span class="px-4 py-2 rounded-lg text-sm border border-indigo-500/30 bg-indigo-500/10 text-indigo-300">AI Infrastructure Boom</span>
      <span class="px-4 py-2 rounded-lg text-sm border border-indigo-500/30 bg-indigo-500/10 text-indigo-300">ESG Requirements</span>
    </div>
  </div>
</section>
