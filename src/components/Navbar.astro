---
const navLinks = [
  { label: "Problem", href: "#problem" },
  { label: "Solution", href: "#solution" },
  { label: "Technology", href: "#technology" },
  { label: "Results", href: "#results" },
  { label: "Market", href: "#market" },
  { label: "Team", href: "#team" },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-[#0a0a0a]/80 backdrop-blur-xl border-b border-white/5">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <img src="/img/arax_labs_logo_square_gradient_clean.png" alt="ARAX LABS" class="h-8 w-8" />
      <span class="font-bold text-lg text-white">ARAX LABS</span>
    </a>
    <div class="hidden md:flex items-center gap-8">
      {navLinks.map(link => (
        <a href={link.href} class="text-sm text-slate-400 hover:text-white transition-colors">
          {link.label}
        </a>
      ))}
      <a href="#contact" class="text-sm bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-lg transition-colors">
        Contact
      </a>
    </div>
  </div>
</nav>
