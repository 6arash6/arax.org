<section id="solution" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold mb-4">
      <span class="gradient-text">The Solution</span>
    </h2>
    <p class="text-slate-400 text-lg mb-12 max-w-2xl">
      AI-driven predictive scaling that reduces energy consumption by 15–30%.
    </p>

    <!-- Big stat -->
    <div class="text-center mb-16">
      <div class="text-6xl md:text-8xl font-bold gradient-text mb-4">15–30%</div>
      <p class="text-xl text-slate-300">OPEX reduction through predictive scaling</p>
    </div>

    <!-- Three pillars -->
    <div class="grid md:grid-cols-3 gap-8 mb-16">
      <div class="gradient-border rounded-2xl p-8 text-center">
        <div class="text-4xl mb-4">🔮</div>
        <h3 class="text-white text-xl font-semibold mb-3">Predictive</h3>
        <p class="text-slate-400">Forecast workload stability before problems occur. Not reactive autoscaling — proactive optimization.</p>
      </div>
      <div class="gradient-border rounded-2xl p-8 text-center">
        <div class="text-4xl mb-4">🔧</div>
        <h3 class="text-white text-xl font-semibold mb-3">Tool-Agnostic</h3>
        <p class="text-slate-400">Works across Kubernetes, Slurm, MPI, OpenStack, Terraform. No vendor lock-in.</p>
      </div>
      <div class="gradient-border rounded-2xl p-8 text-center">
        <div class="text-4xl mb-4">⚡</div>
        <h3 class="text-white text-xl font-semibold mb-3">Energy-Aware</h3>
        <p class="text-slate-400">Minimizes monitoring overhead while maintaining SRE visibility. Kepler-validated energy savings.</p>
      </div>
    </div>

    <!-- Tech brief -->
    <div class="gradient-border rounded-xl p-6 text-center">
      <p class="text-slate-300">
        <strong class="text-white">Core:</strong> eBPF + Kepler telemetry · LightGBM models · ~4ms inference · Model-Predictive Control
      </p>
    </div>
  </div>
</section>
