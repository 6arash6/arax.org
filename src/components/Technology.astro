---
---

<section id="technology" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold mb-4">
      <span class="gradient-text">Technology Stack</span>
    </h2>
    <p class="text-slate-400 text-lg mb-12 max-w-2xl">
      Full-stack: eBPF telemetry → Kepler energy measurement → LightGBM prediction → MPC control.
    </p>

    <!-- Tech grid -->
    <div class="grid md:grid-cols-2 gap-6 mb-12">
      <div class="gradient-border rounded-xl p-6">
        <h3 class="text-indigo-400 font-semibold mb-2">Telemetry</h3>
        <p class="text-slate-300">eBPF, Kepler, Prometheus, OpenTelemetry</p>
      </div>
      <div class="gradient-border rounded-xl p-6">
        <h3 class="text-indigo-400 font-semibold mb-2">ML Models</h3>
        <p class="text-slate-300">LightGBM, XGBoost, LSTM, SGD Online</p>
      </div>
      <div class="gradient-border rounded-xl p-6">
        <h3 class="text-indigo-400 font-semibold mb-2">Orchestration</h3>
        <p class="text-slate-300">Kubernetes, Slurm, MPI, OpenShift, Terraform</p>
      </div>
      <div class="gradient-border rounded-xl p-6">
        <h3 class="text-indigo-400 font-semibold mb-2">Cloud</h3>
        <p class="text-slate-300">Azure, GCP, AWS, OpenStack, Oracle Cloud</p>
      </div>
    </div>

    <!-- Thesis figures -->
    <div class="grid md:grid-cols-2 gap-6">
      <div class="gradient-border rounded-xl overflow-hidden">
        <img src="/img/thesis/fig3_2_top20_mi.png" alt="Feature Importance" class="w-full" />
        <div class="p-4">
          <p class="text-sm text-slate-400">Feature importance analysis — top 20 metrics for stability prediction</p>
        </div>
      </div>
      <div class="gradient-border rounded-xl overflow-hidden">
        <img src="/img/thesis/fig3_3_shap.png" alt="SHAP Analysis" class="w-full" />
        <div class="p-4">
          <p class="text-sm text-slate-400">SHAP values — interpretable model predictions</p>
        </div>
      </div>
    </div>
  </div>
</section>
