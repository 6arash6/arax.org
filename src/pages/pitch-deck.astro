---
import Layout from '~/layouts/Layout.astro';

const metadata = {
  title: 'ARAX LABS Pitch Deck',
  description: 'ARAX LABS investor and grant pitch deck for AI-driven predictive scaling and energy-efficient infrastructure.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <style is:global>
    :root {
      color-scheme: dark;
      --arax-bg: #060b14;
      --arax-surface: rgba(10, 17, 30, 0.72);
      --arax-border: rgba(132, 204, 255, 0.16);
      --arax-text: #e7f0ff;
      --arax-muted: rgba(231, 240, 255, 0.72);
      --arax-accent: #59b8ff;
      --arax-accent-2: #8df0c8;
      --arax-warn: #f6c177;
    }

    body {
      margin: 0;
      background:
        radial-gradient(circle at top left, rgba(89, 184, 255, 0.18), transparent 32%),
        radial-gradient(circle at 85% 20%, rgba(141, 240, 200, 0.16), transparent 24%),
        linear-gradient(160deg, #04070d 0%, #07121f 52%, #020408 100%);
      color: var(--arax-text);
      overflow: hidden;
    }

    .reveal {
      font-family: 'Inter Variable', 'Inter', system-ui, sans-serif;
      color: var(--arax-text);
    }

    .reveal .slides {
      text-align: left;
    }

    .reveal h1,
    .reveal h2,
    .reveal h3 {
      letter-spacing: -0.04em;
      text-transform: none;
      color: var(--arax-text);
      text-wrap: balance;
    }

    .pitch-deck {
      position: relative;
      height: 100vh;
      overflow-y: auto;
      scroll-snap-type: y mandatory;
      scrollbar-width: none;
    }

    .pitch-deck::-webkit-scrollbar {
      display: none;
    }

    .slide-shell {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      scroll-snap-align: start;
    }

    .slide-shell > .slide-card {
      width: min(1200px, calc(100vw - 2rem));
    }

    .slide-nav {
      position: fixed;
      right: 1rem;
      top: 50%;
      transform: translateY(-50%);
      z-index: 20;
      display: grid;
      gap: 0.5rem;
      padding: 0.7rem;
      border-radius: 999px;
      background: rgba(5, 10, 18, 0.55);
      border: 1px solid rgba(132, 204, 255, 0.15);
      backdrop-filter: blur(14px);
    }

    .slide-nav a {
      width: 0.7rem;
      height: 0.7rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.26);
      display: block;
      transition: transform 0.18s ease, background 0.18s ease;
    }

    .slide-nav a:hover,
    .slide-nav a.is-active {
      transform: scale(1.35);
      background: var(--arax-accent-2);
    }

    .slide-card {
      background: var(--arax-surface);
      border: 1px solid var(--arax-border);
      border-radius: 28px;
      box-shadow: 0 20px 80px rgba(0, 0, 0, 0.35);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      padding: clamp(1.25rem, 3vw, 2.5rem);
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.45rem 0.8rem;
      border-radius: 999px;
      border: 1px solid rgba(89, 184, 255, 0.28);
      background: rgba(89, 184, 255, 0.1);
      color: #bfe4ff;
      font-size: 0.78rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .metric {
      display: grid;
      gap: 0.25rem;
      padding: 1rem 1.1rem;
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .metric strong {
      font-size: clamp(1.55rem, 4vw, 2.5rem);
      line-height: 1;
      color: #ffffff;
    }

    .metric span {
      color: var(--arax-muted);
      font-size: 0.95rem;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.1rem;
    }

    .grid-3 {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    .grid-auto {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
    }

    .pill-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .pill-list li {
      padding: 0.55rem 0.8rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.08);
      color: var(--arax-text);
      font-size: 0.88rem;
    }

    .kicker {
      color: var(--arax-accent-2);
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-size: 0.78rem;
      margin-bottom: 0.8rem;
    }

    .lead {
      font-size: clamp(0.9rem, 1.8vw, 1.2rem);
      color: var(--arax-muted);
      max-width: 56rem;
      line-height: 1.4;
    }

    .feature {
      padding: 1rem 1.05rem;
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .feature h3 {
      margin: 0 0 0.45rem;
      font-size: 1.05rem;
    }

    .feature p,
    .small-copy,
    .reveal p,
    .reveal li {
      color: var(--arax-muted);
      line-height: 1.55;
    }

    .hero-mark {
      width: min(96px, 24vw);
      height: min(96px, 24vw);
      object-fit: contain;
      filter: drop-shadow(0 20px 45px rgba(0, 0, 0, 0.35));
    }

    .figure {
      overflow: hidden;
      border-radius: 22px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(0, 0, 0, 0.2);
    }

    .figure img {
      display: block;
      width: 100%;
      height: auto;
    }

    .dashboard-mockup {
      padding: 1rem;
      background:
        radial-gradient(circle at top left, rgba(89, 184, 255, 0.14), transparent 38%),
        linear-gradient(180deg, rgba(6, 12, 22, 0.95), rgba(8, 14, 25, 0.98));
    }

    .dashboard-window {
      border-radius: 20px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      overflow: hidden;
      background: rgba(255, 255, 255, 0.04);
    }

    .dashboard-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.8rem 1rem;
      background: rgba(255, 255, 255, 0.04);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      color: rgba(231, 240, 255, 0.72);
      font-size: 0.88rem;
    }

    .dashboard-dots {
      display: flex;
      gap: 0.45rem;
    }

    .dashboard-dots span {
      width: 0.7rem;
      height: 0.7rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.22);
    }

    .dashboard-body {
      display: grid;
      gap: 0.9rem;
      padding: 1rem;
    }

    .dashboard-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 0.9rem;
    }

    .dashboard-panel {
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.08);
      padding: 0.9rem;
    }

    .dashboard-panel h4 {
      margin: 0 0 0.6rem;
      color: #fff;
      font-size: 0.92rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .bars {
      display: grid;
      gap: 0.5rem;
    }

    .bar {
      display: grid;
      grid-template-columns: 72px 1fr;
      gap: 0.6rem;
      align-items: center;
      font-size: 0.82rem;
      color: rgba(231, 240, 255, 0.72);
    }

    .bar-track {
      position: relative;
      height: 0.7rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.08);
      overflow: hidden;
    }

    .bar-track::after {
      content: '';
      position: absolute;
      inset: 0;
      width: var(--value, 60%);
      border-radius: inherit;
      background: linear-gradient(90deg, #59b8ff, #8df0c8);
    }

    .mini-stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.7rem;
    }

    .mini-stat {
      padding: 0.85rem;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .mini-stat strong {
      display: block;
      font-size: 1.1rem;
      color: #fff;
      margin-bottom: 0.15rem;
    }

    .mini-stat span {
      display: block;
      color: var(--arax-muted);
      font-size: 0.8rem;
    }

    .footer-note {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      font-size: 0.85rem;
      color: rgba(231, 240, 255, 0.58);
      margin-top: 1rem;
    }

    .accent {
      color: var(--arax-accent);
    }

    .warn {
      color: var(--arax-warn);
    }

    @media (max-width: 900px) {
      .grid-2,
      .grid-3 {
        grid-template-columns: 1fr;
      }

      .grid-auto {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .slide-shell:first-of-type .slide-card {
      padding: 0.7rem 0.9rem;
    }

    .slide-shell:first-of-type .grid-2 {
      align-items: center;
    }

    .slide-shell:first-of-type h1 {
      font-size: clamp(1.35rem, 3.8vw, 2.15rem);
      margin: 0.25rem 0 0.35rem;
      line-height: 1.02;
    }

    .slide-shell:first-of-type .lead {
      font-size: 0.72rem;
      line-height: 1.25;
      margin: 0;
    }

    .slide-shell:first-of-type .grid-auto {
      margin-top: 0.45rem;
      gap: 0.4rem;
    }

    .slide-shell:first-of-type .metric {
      padding: 0.45rem 0.55rem;
      border-radius: 12px;
    }

    .slide-shell:first-of-type .metric strong {
      font-size: 0.98rem;
    }

    .slide-shell:first-of-type .metric span {
      font-size: 0.62rem;
    }

    .slide-shell:first-of-type .footer-note {
      display: none;
    }

    .slide-shell:first-of-type .eyebrow {
      padding: 0.3rem 0.55rem;
      font-size: 0.62rem;
      letter-spacing: 0.08em;
    }
  </style>

  <main class="pitch-deck">
    <nav class="slide-nav" aria-label="Slide navigation">
      <a href="#slide-1" title="Hero"></a>
      <a href="#slide-2" title="Problem"></a>
      <a href="#slide-3" title="Solution"></a>
      <a href="#slide-4" title="Product"></a>
      <a href="#slide-5" title="Tech and proof"></a>
      <a href="#slide-6" title="Market"></a>
      <a href="#slide-7" title="Traction"></a>
      <a href="#slide-8" title="Team and ask"></a>
    </nav>

        <section id="slide-1" class="slide-shell">
          <div class="slide-card">
            <div class="grid-2" style="align-items:center; gap:0.8rem;">
              <div>
                <div class="eyebrow">ARAX LABS · Investor / Grant Pitch</div>
                <h1 style="font-size: clamp(1.35rem, 3.8vw, 2.15rem); margin: 0.25rem 0 0.35rem; line-height: 1.02;">
                  AI-Driven Predictive Scaling
                  <br />for Energy-Efficient Infrastructure
                </h1>
                <p class="lead">
                  ARAX LABS turns telemetry into action: we predict instability before it happens, then adapt infrastructure and monitoring to cut energy waste and OPEX in AI / HPC environments.
                </p>
                <div class="grid-auto" style="margin-top: 1.4rem;">
                  <div class="metric">
                    <strong>15–30%</strong>
                    <span>target OPEX reduction</span>
                  </div>
                  <div class="metric">
                    <strong>~4 ms</strong>
                    <span>LightGBM inference latency</span>
                  </div>
                  <div class="metric">
                    <strong>TRL 6</strong>
                    <span>validated in realistic environments</span>
                  </div>
                </div>
              </div>
              <div style="display:flex; justify-content:center; align-items:center;">
                <img class="hero-mark" src="/img/arax_labs_logo_square_gradient_clean.png" alt="ARAX LABS logo" />
              </div>
            </div>
            <div class="footer-note">
              <span>Founder: Arash Javan Mojarad</span>
              <span>arash.javan@araxlabs.org</span>
              <span>araxlabs.org</span>
            </div>
          </div>
        </section>

        <section id="slide-2" class="slide-shell">
          <div class="slide-card">
            <div class="kicker">01 · Problem</div>
            <h2 style="font-size: clamp(2rem, 4.5vw, 3.4rem); margin: 0 0 0.8rem;">AI infrastructure wastes power when it reacts too late.</h2>
            <p class="lead">Load is volatile, monitoring is expensive, and infrastructure still scales on static assumptions instead of predictive signals.</p>
            <div class="grid-2" style="margin-top: 1.4rem;">
              <div class="feature">
                <h3><span class="warn">~30%</span> energy waste</h3>
                <p>Zombie workloads, static resource allocation, and always-on observability create a persistent efficiency gap.</p>
              </div>
              <div class="feature">
                <h3>Grid stress rises with AI scale-up</h3>
                <p>Operators need early signals to avoid expensive peak power and congestion.</p>
              </div>
            </div>
          </div>
        </section>

        <section id="slide-3" class="slide-shell">
          <div class="slide-card">
            <div class="kicker">02 · Solution</div>
            <h2 style="font-size: clamp(2rem, 4.5vw, 3.4rem); margin: 0 0 0.8rem;">Predictive scaling replaces guesswork with control.</h2>
            <div class="grid-3" style="margin-top: 1.2rem;">
              <div class="feature">
                <h3>Predictive</h3>
                <p>Forecast instability before it reaches production so operators can act early.</p>
              </div>
              <div class="feature">
                <h3>Tool-agnostic</h3>
                <p>Works across Kubernetes, Slurm, MPI, OpenShift, Ansible, and Terraform-managed environments.</p>
              </div>
              <div class="feature">
                <h3>Energy-aware</h3>
                <p>Uses eBPF and Kepler telemetry to reduce monitoring overhead while staying actionable.</p>
              </div>
            </div>
            <div class="grid-2" style="margin-top: 1.2rem;">
              <div class="metric">
                <strong>LightGBM</strong>
                <span>best-performing model in the current pipeline</span>
              </div>
              <div class="metric">
                <strong>10x</strong>
                <span>better RMSE than linear baselines in validation</span>
              </div>
            </div>
          </div>
        </section>

        <section id="slide-4" class="slide-shell">
          <div class="slide-card">
            <div class="kicker">03 · Product</div>
            <h2 style="font-size: clamp(2rem, 4.5vw, 3.4rem); margin: 0 0 0.8rem;">One control loop: detect, decide, adapt.</h2>
            <div class="grid-2" style="align-items:start; margin-top: 1rem;">
              <div class="dashboard-mockup">
                <div class="dashboard-window">
                  <div class="dashboard-topbar">
                    <div class="dashboard-dots"><span></span><span></span><span></span></div>
                    <span>ARAX Control Plane · live stability view</span>
                    <span>24h</span>
                  </div>
                  <div class="dashboard-body">
                    <div class="mini-stats">
                      <div class="mini-stat">
                        <strong>94%</strong>
                        <span>stability score</span>
                      </div>
                      <div class="mini-stat">
                        <strong>4.2 ms</strong>
                        <span>model latency</span>
                      </div>
                      <div class="mini-stat">
                        <strong>18%</strong>
                        <span>monitoring overhead cut</span>
                      </div>
                    </div>
                    <div class="dashboard-grid">
                      <div class="dashboard-panel">
                        <h4>Signal pressure</h4>
                        <div class="bars">
                          <div class="bar"><span>CPU</span><div class="bar-track" style="--value:72%"></div></div>
                          <div class="bar"><span>Memory</span><div class="bar-track" style="--value:54%"></div></div>
                          <div class="bar"><span>IO</span><div class="bar-track" style="--value:38%"></div></div>
                          <div class="bar"><span>Energy</span><div class="bar-track" style="--value:66%"></div></div>
                        </div>
                      </div>
                      <div class="dashboard-panel">
                        <h4>Action queue</h4>
                        <p style="margin:0 0 0.7rem;">Adaptive scrape rate</p>
                        <div class="metric" style="margin-bottom:0.7rem;">
                          <strong style="font-size:1.3rem;">Scale up</strong>
                          <span>when instability rises</span>
                        </div>
                        <div class="metric">
                          <strong style="font-size:1.3rem;">Back off</strong>
                          <span>when the cluster is stable</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div>
                <div class="feature" style="margin-bottom: 1rem;">
                  <h3>Signals in</h3>
                  <p>eBPF, Kepler, Prometheus, OpenTelemetry, cluster telemetry.</p>
                </div>
                <div class="feature" style="margin-bottom: 1rem;">
                  <h3>Model in the middle</h3>
                  <p>Low-latency inference turns telemetry into a stability decision.</p>
                </div>
                <div class="feature">
                  <h3>Action out</h3>
                  <p>Adaptive scrape intensity, predictive scaling, and lower-energy operations.</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section id="slide-5" class="slide-shell">
          <div class="slide-card">
            <div class="kicker">04 · Tech & proof</div>
            <h2 style="font-size: clamp(2rem, 4.5vw, 3.4rem); margin: 0 0 0.8rem;">Built on telemetry, validated by thesis results.</h2>
            <div class="grid-3" style="margin-top: 1.2rem;">
              <div class="feature">
                <h3>Telemetry</h3>
                <p>eBPF, Kepler, Prometheus, OpenTelemetry</p>
              </div>
              <div class="feature">
                <h3>Models</h3>
                <p>LightGBM, XGBoost, LSTM, SGD Online</p>
              </div>
              <div class="feature">
                <h3>Orchestration</h3>
                <p>Kubernetes, Slurm, MPI, OpenShift, Terraform</p>
              </div>
            </div>
            <div class="grid-2" style="margin-top: 1.2rem;">
              <div class="figure">
                <img src="/img/thesis/fig3_2_top20_mi.png" alt="Feature importance chart" />
              </div>
              <div class="figure">
                <img src="/img/thesis/fig3_3_shap.png" alt="SHAP analysis chart" />
              </div>
            </div>
            <div class="grid-2" style="margin-top: 1.2rem;">
              <div class="figure">
                <img src="/img/thesis/fig3_4_stability_timeline.png" alt="Stability timeline" />
              </div>
              <div class="figure">
                <img src="/img/thesis/fig3_6_pareto.png" alt="Pareto frontier chart" />
              </div>
            </div>
          </div>
        </section>

        <section id="slide-6" class="slide-shell">
          <div class="slide-card">
            <div class="kicker">05 · Market</div>
            <h2 style="font-size: clamp(2rem, 4.5vw, 3.4rem); margin: 0 0 0.8rem;">Start with data centers, expand into grid intelligence.</h2>
            <div class="grid-2" style="margin-top: 1.2rem;">
              <div class="metric">
                <strong>B2B</strong>
                <span>data centers, cloud providers, AI infrastructure teams</span>
              </div>
              <div class="metric">
                <strong>B2B2B</strong>
                <span>utilities, grid operators, energy market participants</span>
              </div>
            </div>
            <p class="small-copy" style="margin-top: 1rem;">Near-term value is operational savings. Long-term value is a predictive layer for the AI-powered energy stack.</p>
          </div>
        </section>

        <section id="slide-7" class="slide-shell">
          <div class="slide-card">
            <div class="kicker">06 · Traction</div>
            <h2 style="font-size: clamp(2rem, 4.5vw, 3.4rem); margin: 0 0 0.8rem;">Traction comes from research, incubators, and deployment intent.</h2>
            <div class="grid-3" style="margin-top: 1.2rem;">
              <div class="feature">
                <h3>INiTS ScaleUp</h3>
                <p>Accepted into Vienna’s high-tech incubator with access to startup support and capital pathways.</p>
              </div>
              <div class="feature">
                <h3>AWS First Incubator 2026</h3>
                <p>Pitch video submitted, with infrastructure and mentorship needs clearly defined.</p>
              </div>
              <div class="feature">
                <h3>Research pipeline</h3>
                <p>ML pipeline complete, LightGBM validated on mock data, real-world experiments pending.</p>
              </div>
            </div>
          </div>
        </section>

        <section id="slide-8" class="slide-shell">
          <div class="slide-card">
            <div class="kicker">07 · Team & ask</div>
            <h2 style="font-size: clamp(2rem, 4.5vw, 3.4rem); margin: 0 0 0.8rem;">Built by one founder who spans energy systems, MLOps, and supercomputing.</h2>
            <div class="grid-2" style="margin-top: 1.2rem; align-items:start;">
              <div class="feature">
                <h3>Arash Javan Mojarad</h3>
                <p>Master’s in Data Science at FH Technikum Wien, background in energy systems, distributed systems, and platform engineering at TU Wien’s MUSICA supercomputer.</p>
              </div>
              <div class="feature">
                <h3>What we need</h3>
                <p>Infrastructure credits, design partners, and strategic mentorship to turn research into a product.</p>
              </div>
            </div>
            <div class="footer-note" style="margin-top: 1.6rem;">
              <span><span class="accent">arash.javan@araxlabs.org</span></span>
              <span><span class="accent">araxlabs.org</span></span>
              <span><span class="accent">@AraX-Labs</span></span>
            </div>
          </div>
        </section>
  </main>

  <script is:inline>
    const deck = document.querySelector('.pitch-deck');
    const links = Array.from(document.querySelectorAll('.slide-nav a'));
    const slides = Array.from(document.querySelectorAll('.slide-shell'));

    if (deck && slides.length && links.length) {
      const setActive = (index) => {
        links.forEach((link, linkIndex) => {
          link.classList.toggle('is-active', linkIndex === index);
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

          if (!visible) return;

          const index = slides.indexOf(visible.target);
          if (index >= 0) {
            setActive(index);
          }
        },
        { root: deck, threshold: [0.35, 0.55, 0.7] },
      );

      slides.forEach((slide) => observer.observe(slide));
      setActive(0);

      deck.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp' && event.key !== 'PageDown' && event.key !== 'PageUp') {
          return;
        }

        event.preventDefault();
        const activeIndex = links.findIndex((link) => link.classList.contains('is-active'));
        const nextIndex =
          event.key === 'ArrowDown' || event.key === 'PageDown'
            ? Math.min(slides.length - 1, activeIndex + 1)
            : Math.max(0, activeIndex - 1);

        slides[nextIndex].scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      deck.tabIndex = 0;
    }
  </script>
</Layout>